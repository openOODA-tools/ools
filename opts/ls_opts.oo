// # ools Options Definition & CLI Parser
//
// Logline: Defines command-line options and parses raw CLI argv into configuration state.
//
// Setup: Demands pure input strings; produces immutable LsOpts configuration struct.
//
// Beats:
//   1. Define LsOpts structure representing listing configuration and flags.
//   2. Initialize default options configuration.
//   3. Parse POSIX flags, combined short options, and positional path arguments.

pub type LsOpts = struct {
    long_format: Bool,
    all_files: Bool,
    almost_all: Bool,
    human_readable: Bool,
    classify: Bool,
    sort_time: Bool,
    sort_size: Bool,
    reverse: Bool,
    recursive: Bool,
    one_per_line: Bool,
    directory_only: Bool,
    color_mode: String,
    theme_name: String,
    json_mode: Bool,
    mcp_mode: Bool,
    show_help: Bool,
    show_version: Bool,
    error_msg: String,
    paths: List[String]
};

pub fn default_opts() -> LsOpts {
    return LsOpts {
        long_format: false,
        all_files: false,
        almost_all: false,
        human_readable: false,
        classify: false,
        sort_time: false,
        sort_size: false,
        reverse: false,
        recursive: false,
        one_per_line: false,
        directory_only: false,
        color_mode: "auto",
        theme_name: "default",
        json_mode: false,
        mcp_mode: false,
        show_help: false,
        show_version: false,
        error_msg: "",
        paths: list_new()
    };
}

pub fn parse_cli_args(args: List[String]) -> LsOpts {
    let mut opts: LsOpts = default_opts();
    let n: Int = list_len(args);
    let mut i: Int = 0;
    let mut end_of_opts: Bool = false;

    while i < n {
        let arg: String = list_get(args, i);
        let arg_len: Int = chars_len(arg);

        if end_of_opts {
            opts.paths = list_push(opts.paths, arg);
            i = i + 1;
        } else if arg == "--" {
            end_of_opts = true;
            i = i + 1;
        } else if arg == "--help" || arg == "-help" {
            opts.show_help = true;
            i = i + 1;
        } else if arg == "--version" {
            opts.show_version = true;
            i = i + 1;
        } else if arg == "--mcp" {
            opts.mcp_mode = true;
            i = i + 1;
        } else if arg == "--json" {
            opts.json_mode = true;
            i = i + 1;
        } else if arg == "--all" {
            opts.all_files = true;
            i = i + 1;
        } else if arg == "--almost-all" {
            opts.almost_all = true;
            i = i + 1;
        } else if arg == "--human-readable" {
            opts.human_readable = true;
            i = i + 1;
        } else if arg == "--classify" {
            opts.classify = true;
            i = i + 1;
        } else if arg == "--reverse" {
            opts.reverse = true;
            i = i + 1;
        } else if arg == "--recursive" {
            opts.recursive = true;
            i = i + 1;
        } else if arg == "--directory" {
            opts.directory_only = true;
            i = i + 1;
        } else if arg == "--color" {
            if i + 1 < n {
                opts.color_mode = list_get(args, i + 1);
                i = i + 2;
            } else {
                opts.color_mode = "always";
                i = i + 1;
            }
        } else if str_starts_with(arg, "--color=") {
            opts.color_mode = str_slice(arg, 8, arg_len);
            i = i + 1;
        } else if str_starts_with(arg, "--theme=") {
            opts.theme_name = str_slice(arg, 8, arg_len);
            i = i + 1;
        } else if str_starts_with(arg, "--") {
            opts.error_msg = "unrecognized option '" + arg + "'";
            return opts;
        } else if str_starts_with(arg, "-") && arg_len > 1 {
            let mut k: Int = 1;
            while k < arg_len {
                let c: String = char_at(arg, k);
                if c == "l" {
                    opts.long_format = true;
                } else if c == "a" {
                    opts.all_files = true;
                } else if c == "A" {
                    opts.almost_all = true;
                } else if c == "h" {
                    opts.human_readable = true;
                } else if c == "F" {
                    opts.classify = true;
                } else if c == "t" {
                    opts.sort_time = true;
                } else if c == "S" {
                    opts.sort_size = true;
                } else if c == "r" {
                    opts.reverse = true;
                } else if c == "R" {
                    opts.recursive = true;
                } else if c == "1" {
                    opts.one_per_line = true;
                } else if c == "d" {
                    opts.directory_only = true;
                } else if c == "v" || c == "V" {
                    opts.show_version = true;
                } else {
                    opts.error_msg = "invalid option -- '" + c + "'";
                    return opts;
                }
                k = k + 1;
            }
            i = i + 1;
        } else {
            opts.paths = list_push(opts.paths, arg);
            i = i + 1;
        }
    }

    if list_len(opts.paths) == 0 {
        opts.paths = list_push(opts.paths, ".");
    }

    return opts;
}
