// # ools Icon and Glyph Mapping
//
// Logline: Maps semantic file kinds and extensions to Unicode glyphs and classify indicators.
//
// Setup: Pure string mapping function returning appropriate prefix icon for rendering.
//
// Beats:
//   1. Check special file types and assign domain glyphs.
//   2. Check extension-specific associations for developer ergonomics.
//   3. Provide classify suffix indicator flags.

pub fn get_kind_icon(kind: String) -> String {
    if kind == "directory" {
        return "📁";
    }
    if kind == "executable" {
        return "⚙️";
    }
    if kind == "symlink" {
        return "🔗";
    }
    if kind == "archive" {
        return "📦";
    }
    if kind == "source" {
        return "📄";
    }
    if kind == "document" {
        return "📝";
    }
    if kind == "media" {
        return "🎬";
    }
    return "  ";
}

pub fn get_classify_suffix(kind: String) -> String {
    if kind == "directory" {
        return "/";
    }
    if kind == "executable" {
        return "*";
    }
    if kind == "symlink" {
        return "@";
    }
    return "";
}
