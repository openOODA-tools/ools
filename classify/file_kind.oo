// # ools File Kind Classifier
//
// Logline: Determines semantic category of files based on extension, mode bits, and MIME.
//
// Setup: Pure classification function mapping filename and status into categorical kind string.
//
// Beats:
//   1. Check special filesystem node types (directory, symlink).
//   2. Check archive formats and compressed archives.
//   3. Inspect filename extension against known category tables.

pub fn classify_entry_kind(name: String, is_dir: Bool, is_symlink: Bool) -> String {
    if is_symlink {
        return "symlink";
    }
    if is_dir {
        return "directory";
    }

    if str_ends_with(name, ".tar") || str_ends_with(name, ".tar.gz") || str_ends_with(name, ".tar.zst") || str_ends_with(name, ".tgz") || str_ends_with(name, ".zip") || str_ends_with(name, ".gz") || str_ends_with(name, ".zst") || str_ends_with(name, ".pkg.tar.zst") {
        return "archive";
    }

    if str_ends_with(name, ".oo") || str_ends_with(name, ".oot") || str_ends_with(name, ".rs") || str_ends_with(name, ".c") || str_ends_with(name, ".h") || str_ends_with(name, ".cpp") || str_ends_with(name, ".go") || str_ends_with(name, ".py") || str_ends_with(name, ".js") || str_ends_with(name, ".ts") || str_ends_with(name, ".json") || str_ends_with(name, ".toml") || str_ends_with(name, ".yaml") || str_ends_with(name, ".yml") || str_ends_with(name, ".sh") {
        return "source";
    }

    if str_ends_with(name, ".md") || str_ends_with(name, ".txt") || str_ends_with(name, ".pdf") || str_ends_with(name, ".csv") || str_ends_with(name, ".log") {
        return "document";
    }

    if str_ends_with(name, ".png") || str_ends_with(name, ".jpg") || str_ends_with(name, ".jpeg") || str_ends_with(name, ".gif") || str_ends_with(name, ".svg") || str_ends_with(name, ".webp") || str_ends_with(name, ".mp4") || str_ends_with(name, ".mp3") {
        return "media";
    }

    if str_ends_with(name, ".bin") || str_ends_with(name, ".so") || str_ends_with(name, ".o") || str_ends_with(name, ".a") {
        return "executable";
    }

    return "regular";
}
