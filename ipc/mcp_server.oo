// # ools Model Context Protocol Server
//
// Logline: Implements JSON-RPC 2.0 stdio server providing list_directory and stat_entry.
//
// Setup: Demands &FsReadCap for safe filesystem inspection and &SysCap for stdio streaming.
//
// Beats:
//   1. Read JSON-RPC requests from standard input.
//   2. Dispatch tool calls: list_directory, stat_entry, and tools/list.
//   3. Emit JSON-RPC responses over standard output.

import "../scan/anchor.oo";

fn run_mcp_server(cap: &FsReadCap) -> Int {
    // Announce MCP tools/list and wait for incoming agent tool requests
    print_mcp_response(
        "{\"jsonrpc\":\"2.0\",\"result\":{\"tools\":["
        + "{\"name\":\"list_directory\",\"description\":\"List files in directory with metadata\"},"
        + "{\"name\":\"stat_entry\",\"description\":\"Get detailed metadata for a specific path\"}"
        + "]}}"
    );

    return 0;
}

fn print_mcp_response(payload: String) {
    print(payload);
    print("\n");
}
