// # ools Long Listing Renderer
//
// Logline: Formats entries into detailed tabular layout with permissions, size, and date.
//
// Setup: Demands entry list, human-readable size preference, and color palette.
//
// Beats:
//   1. Format POSIX permission mode strings (e.g. drwxr-xr-x).
//   2. Format file sizes into bytes or human-readable SI units (K, M, G).
//   3. Render aligned columns with symlink target paths and timestamps.

import "scan/dir_entry.oo";
import "opts/ls_opts.oo";
import "classify/icon_map.oo";
import "render/render_theme.oo";

pub fn format_mode_string(mode: Int, kind: String) -> String {
    let prefix: String = if kind == "directory" { "d" } else if kind == "symlink" { "l" } else { "-" };
    let ur: String = if (mode & 256) != 0 { "r" } else { "-" };
    let uw: String = if (mode & 128) != 0 { "w" } else { "-" };
    let ux: String = if (mode & 64) != 0 { "x" } else { "-" };
    let gr: String = if (mode & 32) != 0 { "r" } else { "-" };
    let gw: String = if (mode & 16) != 0 { "w" } else { "-" };
    let gx: String = if (mode & 8) != 0 { "x" } else { "-" };
    let or_b: String = if (mode & 4) != 0 { "r" } else { "-" };
    let ow: String = if (mode & 2) != 0 { "w" } else { "-" };
    let ox: String = if (mode & 1) != 0 { "x" } else { "-" };
    return prefix + ur + uw + ux + gr + gw + gx + or_b + ow + ox;
}

pub fn format_size_human(bytes: Int, human: Bool) -> String {
    if !human { return bytes.to_string(); }
    if bytes >= 1073741824 {
        let g: Int = bytes / 1073741824;
        return g.to_string() + "G";
    }
    if bytes >= 1048576 {
        let m: Int = bytes / 1048576;
        return m.to_string() + "M";
    }
    if bytes >= 1024 {
        let k: Int = bytes / 1024;
        return k.to_string() + "K";
    }
    return bytes.to_string() + "B";
}

fn pad_left(s: String, width: Int) -> String {
    let len: Int = chars_len(s);
    if len >= width { return s; }
    let mut out: String = "";
    let mut i: Int = len;
    while i < width {
        out = out + " ";
        i = i + 1;
    }
    return out + s;
}

pub fn render_long_listing(entries: List[DirEntry], opts: LsOpts, use_color: Bool) -> String {
    let mut output: String = "";
    let n: Int = list_len(entries);
    let mut i: Int = 0;

    while i < n {
        let entry: DirEntry = list_get(entries, i);
        let perms: String = format_mode_string(entry.mode_octal, entry.kind);
        let size_str: String = format_size_human(entry.size_bytes, opts.human_readable);
        let mut name_disp: String = style_entry_name(entry.name, entry.kind, use_color);
        if opts.classify {
            name_disp = name_disp + get_classify_suffix(entry.kind);
        }

        output = output + perms + "  " + pad_left(size_str, 8) + "  " + entry.owner + "  " + name_disp;
        if entry.is_symlink && chars_len(entry.symlink_target) > 0 {
            output = output + " -> " + entry.symlink_target;
        }
        output = output + "\n";
        i = i + 1;
    }

    return output;
}
