// # ools Directory Entry Representation
//
// Logline: Data structure representing a single filesystem node with parsed metadata.
//
// Setup: Pure value structure representing file metadata, permissions, and timestamps.
//
// Beats:
//   1. Define DirEntry structure holding metadata attributes.
//   2. Provide constructor helper for instantiating directory entries.
//   3. Implement comparator helper for sorting entries.

struct DirEntry {
    name: String,
    path: String,
    kind: String,
    size_bytes: Int,
    mode_octal: Int,
    owner: String,
    group: String,
    mod_time: Int,
    is_symlink: Bool,
    symlink_target: String,
    is_hidden: Bool
}

fn new_dir_entry(
    name: String,
    path: String,
    kind: String,
    size: Int,
    mode: Int,
    owner: String,
    group: String,
    mtime: Int,
    is_link: Bool,
    target: String
) -> DirEntry {
    let hidden: Bool = string_starts_with(name, ".") && !string_eq(name, ".") && !string_eq(name, "..");
    return DirEntry {
        name: name,
        path: path,
        kind: kind,
        size_bytes: size,
        mode_octal: mode,
        owner: owner,
        group: group,
        mod_time: mtime,
        is_symlink: is_link,
        symlink_target: target,
        is_hidden: hidden
    };
}

fn compare_entries_by_name(a: DirEntry, b: DirEntry) -> Int {
    if string_less(a.name, b.name) {
        return -1;
    } else if string_eq(a.name, b.name) {
        return 0;
    }
    return 1;
}
