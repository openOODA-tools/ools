// # ools Directory Entry Representation
//
// Logline: Data structure representing a single filesystem node with parsed metadata.
//
// Setup: Pure value structure representing file metadata, permissions, and timestamps.
//
// Beats:
//   1. Define DirEntry structure holding metadata attributes.
//   2. Provide constructor helper for instantiating directory entries.
//   3. Determine entry hidden status and construct valid records.

pub type DirEntry = struct {
    name: String,
    path: String,
    kind: String,
    size_bytes: Int,
    mode_octal: Int,
    owner: String,
    group: String,
    mod_time: Int,
    is_symlink: Bool,
    symlink_target: String,
    is_hidden: Bool
};

pub fn new_dir_entry(
    name: String,
    path: String,
    kind: String,
    size: Int,
    mode: Int,
    owner: String,
    group: String,
    mtime: Int,
    is_link: Bool,
    target: String
) -> DirEntry {
    let hidden: Bool = chars_len(name) > 1 && char_at(name, 0) == ".";
    return DirEntry {
        name: name,
        path: path,
        kind: kind,
        size_bytes: size,
        mode_octal: mode,
        owner: owner,
        group: group,
        mod_time: mtime,
        is_symlink: is_link,
        symlink_target: target,
        is_hidden: hidden
    };
}
