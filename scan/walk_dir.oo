// # ools Directory Scanner & Traversal
//
// Logline: Scans directory entries using &FsReadCap and applies filtering and sorting.
//
// Setup: Demands &FsReadCap token for directory read access; returns List[DirEntry].
//
// Beats:
//   1. Verify path exists and determine if path is a file or directory.
//   2. Read directory entries using capability-bounded readdir.
//   3. Filter hidden files according to CLI options.
//   4. Sort entries by name, time, size, or reverse order.

import "scan/dir_entry.oo";
import "scan/file_stat.oo";
import "scan/sort_entries.oo";
import "opts/ls_opts.oo";
import "std/fs/os/fs.oo";

fn join_subpath(base: String, name: String) -> String {
    if base == "." { return name; }
    if chars_len(base) == 0 { return name; }
    if str_ends_with(base, "/") { return base + name; }
    return base + "/" + name;
}

fn scan_dir_depth(
    cap: &FsReadCap,
    root: String,
    target_path: String,
    opts: LsOpts,
    depth: Int
) -> List[DirEntry] {
    let mut entries: List[DirEntry] = list_new();

    if !path_exists(cap, target_path) || depth > 32 {
        return entries;
    }

    let is_dir: Bool = fs_is_dir(cap, target_path);
    let is_sym: Bool = probe_is_symlink(cap, target_path);
    if (!is_dir || is_sym) || opts.directory_only {
        let entry: DirEntry = stat_path_entry(cap, target_path, target_path);
        entries = list_push(entries, entry);
        return entries;
    }

    let raw_entries: List[String] = fs_read_dir(cap, target_path);
    let n: Int = list_len(raw_entries);
    let mut i: Int = 0;

    if opts.all_files && depth == 0 {
        let dot_entry: DirEntry = stat_path_entry(cap, join_subpath(target_path, "."), ".");
        let dotdot_entry: DirEntry = stat_path_entry(cap, join_subpath(target_path, ".."), "..");
        entries = list_push(entries, dot_entry);
        entries = list_push(entries, dotdot_entry);
    }

    while i < n {
        let entry_name: String = list_get(raw_entries, i);
        let is_hidden: Bool = chars_len(entry_name) > 0 && char_at(entry_name, 0) == ".";

        let mut include: Bool = true;
        if is_hidden {
            if !opts.all_files && !opts.almost_all {
                include = false;
            }
        }

        if include {
            let full_path: String = join_subpath(target_path, entry_name);
            let disp_name: String = if depth > 0 {
                let prefix: String = if root == "." { "" } else { root + "/" };
                if chars_len(prefix) > 0 && str_starts_with(full_path, prefix) {
                    str_slice(full_path, chars_len(prefix), chars_len(full_path))
                } else {
                    full_path
                }
            } else {
                entry_name
            };

            let entry: DirEntry = stat_path_entry(cap, full_path, disp_name);
            entries = list_push(entries, entry);

            if opts.recursive && entry.kind == "directory" && !entry.is_symlink && entry_name != "." && entry_name != ".." {
                let sub_entries: List[DirEntry] = scan_dir_depth(cap, root, full_path, opts, depth + 1);
                let ns: Int = list_len(sub_entries);
                let mut k: Int = 0;
                while k < ns {
                    entries = list_push(entries, list_get(sub_entries, k));
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }

    if depth == 0 {
        return sort_dir_entries(entries, opts.sort_time, opts.sort_size, opts.sort_ext, opts.reverse);
    }
    return entries;
}

pub fn scan_directory(cap: &FsReadCap, target_path: String, opts: LsOpts) -> List[DirEntry] {
    return scan_dir_depth(cap, target_path, target_path, opts, 0);
}
