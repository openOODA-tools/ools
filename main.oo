// # ools Main Entry Point
//
// Logline: Sovereign directory listing and metadata classification CLI utility.
//
// Setup: Demands &FsReadCap for directory reads and &EnvCap for terminal/palette discovery.
//
// Beats:
//   1. Parse command-line options and handle --help, --version, or --mcp branches.
//   2. Read directory stream using capability-bounded scanner.
//   3. Render directory entries using grid or long format to standard output.

import "opts/anchor.oo";
import "scan/anchor.oo";
import "classify/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

fn render_help() -> String {
    return "ools 0.2.0 (openOODA sovereign directory lister)\n"
        + "usage: ools [options] [FILE]...\n\n"
        + "List information about the FILEs (the current directory by default).\n"
        + "Sort entries alphabetically if neither -t nor -S is specified.\n\n"
        + "Options:\n"
        + "  -l                   use a long listing format with permissions and size\n"
        + "  -a, --all            do not ignore entries starting with .\n"
        + "  -A, --almost-all     do not list implied . and ..\n"
        + "  -h, --human-readable with -l, print sizes like 1K 234M 2G\n"
        + "  -F, --classify       append indicator (one of */=>@|) to entries\n"
        + "  -t                   sort by modification time, newest first\n"
        + "  -S                   sort by file size, largest first\n"
        + "  -r, --reverse        reverse order while sorting\n"
        + "  -R, --recursive      list subdirectories recursively\n"
        + "  -1                   list one file per line\n"
        + "  -d, --directory      list directories themselves, not their contents\n"
        + "      --color <WHEN>   colorize output: auto, always, never [default: auto]\n"
        + "      --theme <NAME>   override active oote palette\n"
        + "      --json           output entries formatted as JSON Lines\n"
        + "      --mcp            run as Model Context Protocol stdio server\n"
        + "  -h, --help           display this help and exit\n"
        + "  -v, -V, --version    output version information and exit\n";
}

pub fn main(cap_fs: &FsReadCap, cap_env: &EnvCap, args: List[String]) -> Int {
    let opts: LsOpts = parse_cli_args(args);

    if chars_len(opts.error_msg) > 0 {
        println("ools: " + opts.error_msg);
        println("Try 'ools --help' for more information.");
        return 2;
    }

    if opts.show_help {
        print(render_help());
        return 0;
    }

    if opts.show_version {
        println("ools 0.2.0 (openOODA sovereign directory lister)");
        return 0;
    }

    if opts.mcp_mode {
        return run_mcp_server(cap_fs);
    }

    let use_color: Bool = should_enable_colors(cap_env, opts.color_mode);
    let term_width: Int = 80;
    let num_paths: Int = list_len(opts.paths);
    let mut exit_status: Int = 0;
    let mut i: Int = 0;

    while i < num_paths {
        let p: String = list_get(opts.paths, i);
        if !path_exists(cap_fs, p) {
            println("ools: cannot access '" + p + "': No such file or directory");
            exit_status = 2;
        } else {
            if num_paths > 1 && !opts.json_mode {
                println(p + ":");
            }
            let entries: List[DirEntry] = scan_directory(cap_fs, p, opts);
            if opts.json_mode {
                print(render_entries_json_lines(entries));
            } else if opts.long_format {
                print(render_long_listing(entries, opts, use_color));
            } else {
                print(render_grid(entries, term_width, opts, use_color));
            }
            if num_paths > 1 && i + 1 < num_paths && !opts.json_mode {
                println("");
            }
        }
        i = i + 1;
    }

    return exit_status;
}
